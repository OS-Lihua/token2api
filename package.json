{
	"name": "vane",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:reset": "prisma migrate reset --force",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"docker:app": "./scripts/docker-compose.sh -f docker-compose.app.yml up --build",
		"docker:db": "./scripts/docker-compose.sh up -d postgres",
		"dev": "node scripts/dev.mjs",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"postinstall": "prisma generate",
		"prepare": "node scripts/install-hooks.mjs",
		"preview": "next build && next start",
		"react-doctor": "react-doctor . --yes --no-supply-chain --no-telemetry",
		"release:date": "node scripts/release-date.mjs --write",
		"release:date:check": "node scripts/release-date.mjs --check",
		"start": "node scripts/start.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "node scripts/verify.mjs",
		"dev:web": "pnpm connector:build && next dev --turbo --hostname 127.0.0.1",
		"chain": "tsx scripts/chain.ts",
		"contracts:compile": "node scripts/compile.mjs",
		"test:e2e": "tsx scripts/smoke.ts",
		"test:api": "tsx scripts/api-smoke.ts",
		"setup": "node scripts/setup.mjs",
		"deploy:evm": "tsx scripts/deploy.ts",
		"escrow:admin": "node --conditions=react-server --import tsx scripts/escrow-admin.ts",
		"worker": "node --conditions=react-server --import tsx scripts/worker.ts",
		"review:resolve": "node --conditions=react-server --import tsx scripts/resolve-review.ts",
		"preview:local": "node scripts/dev.mjs --production",
		"test:recovery": "tsx scripts/recovery-smoke.ts",
		"connector": "tsx scripts/connector.ts",
		"cli": "tsx scripts/cli.ts",
		"connector:build": "node scripts/build-connector.mjs",
		"test:connector": "node --conditions=react-server --import tsx scripts/connector-smoke.ts",
		"test:stable": "node --conditions=react-server --import tsx scripts/native-smoke.ts --stable",
		"test:native": "node --conditions=react-server --import tsx scripts/native-smoke.ts"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^7.3.4",
		"@openzeppelin/contracts": "^5.4.0",
		"@prisma/client": "^6.19.3",
		"@radix-ui/react-select": "^2.4.1",
		"@rainbow-me/rainbowkit": "^2.2.11",
		"@sentry/nextjs": "^10.78.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.107.1",
		"@trpc/client": "^11.28.0",
		"@trpc/react-query": "^11.28.0",
		"@trpc/server": "^11.28.0",
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.41.0",
		"@x402/core": "^2.30.0",
		"@x402/evm": "^2.30.0",
		"@x402/extensions": "^2.30.0",
		"@x402/svm": "^2.30.0",
		"iron-session": "^8.0.4",
		"lucide-react": "^0.577.0",
		"next": "16.4.6",
		"openai": "^6.0.0",
		"pino": "^10.4.0",
		"posthog-js": "^1.447.11",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"undici": "^8.12.4",
		"viem": "^2.57.18",
		"wagmi": "^2.19.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ajv": "^8.17.1",
		"dotenv": "^17.4.2",
		"esbuild": "0.28.2",
		"ganache": "^7.9.2",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.32",
		"prisma": "^6.19.3",
		"react-doctor": "^0.9.22",
		"solc": "^0.8.38",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=24.0.0"
	}
}
